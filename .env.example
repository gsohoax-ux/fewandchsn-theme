# Copy this file to ".env" and fill in your keys.  NEVER share your .env file.

# --- Telegram (alerts) -------------------------------------------------------
# 1. In Telegram, message @BotFather, send /newbot, follow the steps -> it gives you a token.
# 2. Send any message to your new bot, then start pump-scout: it prints your chat id
#    in the log (or use the /chatid command in the bot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Helius (on-chain bundle + funding-wallet tracing) -----------------------
# Free key at https://dashboard.helius.dev  (free tier is enough to start)
HELIUS_API_KEY=

# --- Anthropic (AI narrative scoring, optional) ------------------------------
# Key from https://console.anthropic.com . Without it, a simpler rule-based
# narrative score is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MAX_CALLS_PER_HOUR=120

# --- Dashboard ---------------------------------------------------------------
PORT=8080
# Set a password if your server is on the internet (username can be anything)
DASHBOARD_PASSWORD=

# --- Padre link in alerts (optional) -----------------------------------------
# Open any coin in Padre, copy the URL, and replace the contract address with {mint}
PADRE_URL_TEMPLATE=

# --- Tuning (defaults are sensible; change later once you see results) --------
ALERT_MIN_SCORE=65
FRESH_MIN_BUYERS=15
MID_PROGRESS_PCT=35
MAX_BUNDLE_PCT=15
MAX_DEV_PCT=8
MAX_TOP10_PCT=35
# Wallets you consider "smart money", comma separated
SMART_WALLETS=
