# Copy this file to ".env" and fill in your keys.  NEVER share your .env file.

# --- Phone alerts with ntfy (recommended) -----------------------------------
# 1. Install the free "ntfy" app (App Store / Google Play).
# 2. Leave NTFY_TOPIC empty: the bot makes a secret topic name on first start and
#    prints it in the log ("subscribe to topic: memecoin-bot-...").
# 3. In the ntfy app tap "+", type that topic name, Subscribe. Done.
# Anyone who knows the topic name can read your alerts, so keep it secret.
NTFY_TOPIC=
# Optional: your dashboard address, adds a "Dashboard" button to alerts
DASHBOARD_URL=

# --- Telegram (optional, instead of or as well as ntfy) ----------------------
# Message @BotFather in Telegram, send /newbot -> token. Then send /chatid to your bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Helius (on-chain bundle + funding-wallet tracing) -----------------------
# Free key at https://dashboard.helius.dev  (free tier is enough to start)
HELIUS_API_KEY=

# --- Anthropic (AI narrative scoring, optional) ------------------------------
# Key from https://console.anthropic.com . Without it, a simpler rule-based
# narrative score is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_MAX_CALLS_PER_HOUR=20

# --- X (Twitter) watcher, optional ---------------------------------------------
# Finds new viral, meme-able posts on X and alerts you when a Pump.fun coin about one
# is rising AND passes safety. Needs a paid X API "Bearer token" from developer.x.com.
# Check X's current API pricing first - reading posts costs money.
X_BEARER_TOKEN=
# Accounts to watch (comma separated, no @). Default: elonmusk, realDonaldTrump, cz_binance, MrBeast
X_WATCH_ACCOUNTS=
# Optional extra X search, e.g.  has:videos lang:en (lol OR insane)
X_SEARCH_QUERY=
# How often to check X, in seconds. Lower = faster but costs more.
X_POLL_SECONDS=180
# Phone alert for very meme-able new posts (1 = on, 0 = off) and the meme score needed
X_POST_ALERTS=1
X_POST_ALERT_MIN=80
# Momentum a coin needs before an X-narrative alert
X_MIN_MOMENTUM=50

# --- Dashboard ---------------------------------------------------------------
PORT=8080
# Set a password if your server is on the internet (username can be anything)
DASHBOARD_PASSWORD=

# --- Padre link in alerts (optional) -----------------------------------------
# Open any coin in Padre, copy the URL, and replace the contract address with {mint}
PADRE_URL_TEMPLATE=

# --- Tuning (defaults are sensible; change later once you see results) --------
ALERT_MIN_SCORE=65
FRESH_MIN_BUYERS=15
MID_PROGRESS_PCT=35
MAX_BUNDLE_PCT=15
MAX_DEV_PCT=8
MAX_TOP10_PCT=35
# Wallets you consider "smart money", comma separated
SMART_WALLETS=
